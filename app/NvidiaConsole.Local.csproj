<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NVIDIA 코딩 콘솔 (로컬판) — 웹페이지 없이 WinForms 로 직접 그리는 프로그램.
    빌드:  dotnet publish -c Release   →  dist\NvidiaConsole.exe (파일 하나)
    확인:  빌드한 exe 에 selftest 옵션을 주면 화면 없이 점검만 하고 끝난다
    실행에는 .NET 10 데스크톱 런타임이 필요하다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>NvidiaConsole</AssemblyName>
    <RootNamespace>NvidiaConsole</RootNamespace>
    <Product>NVIDIA 코딩 콘솔 (로컬)</Product>
    <AssemblyTitle>NVIDIA 코딩 콘솔 (로컬)</AssemblyTitle>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>dist\</PublishDir>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>


</Project>
