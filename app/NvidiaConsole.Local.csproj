<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Zako Code — 웹페이지 없이 WinForms 로 직접 그리는 코딩 도우미.
    빌드:  dotnet publish -c Release   →  dist\ZakoCode.exe (파일 하나)
    확인:  빌드한 exe 에 selftest 옵션을 주면 화면 없이 점검만 하고 끝난다
    런타임을 품고 있어 .NET 을 따로 깔지 않아도 된다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>ZakoCode</AssemblyName>
    <RootNamespace>NvidiaConsole</RootNamespace>
    <Product>Zako Code</Product>
    <AssemblyTitle>Zako Code</AssemblyTitle>
    <Version>2.12.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 런타임까지 EXE 안에 넣는다: 받는 사람이 .NET 을 따로 깔 필요가 없다.
         대신 파일이 커지므로 압축한다. WinForms 는 트리밍을 지원하지 않아 더 줄이진 못한다. -->
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>dist\</PublishDir>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>


</Project>
